# Base URL of the local Ollama HTTP API.
OLLAMA_BASE_URL=http://localhost:11434

# Local model used for summarisation. Pull it first: `ollama pull qwen3:8b`
OLLAMA_MODEL=qwen3:8b

# Optional tuning. Local inference is slow, so the read timeout is generous.
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=300

# Optional map-reduce chunking limits.
SUMMARY_CHUNK_CHARS=12000
SUMMARY_CHUNK_PAGES=6

# Development diagnostics. Logs chunk ranges, which fields each MAP call filled,
# JSON cleanup, REDUCE selections and per-call timings. Never logs paper text.
SUMMARY_DEBUG=false

# Generation options for the extraction prompts.
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT_MAP=2048
OLLAMA_NUM_PREDICT_REDUCE=3072

# Embedding model for Ask the Paper retrieval. A dedicated embedding model is
# strongly preferred over the generation model. Pull it first:
#   ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
# Chunks sent per /api/embed request.
OLLAMA_EMBED_BATCH=16

# Origin allowed by CORS. This is the Vite dev server by default; change it if
# you serve the frontend from somewhere else.
FRONTEND_ORIGIN=http://localhost:5173

# --- Ask the Paper ---
# Token budget for one grounded answer.
OLLAMA_NUM_PREDICT_ANSWER=768
# Most passages that may be sent to the model for a single question.
ASK_MAX_EVIDENCE_CHUNKS=4
# How many ranked passages evidence selection may choose from.
ASK_SELECTION_POOL=12
# How many embedded papers to keep in memory (bounded, process-local).
ASK_EMBEDDING_CACHE_SIZE=4
